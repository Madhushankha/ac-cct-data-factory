{
  "name": "playwright-baggage",
  "version": "0.1.0",
  "private": true,
  "description": "Ask AC baggage chat: Playwright end-to-end suite (OTP broker, transcripts, screenshots, Markdown report)",
  "type": "commonjs",
  "scripts": {
    "serve": "node scripts/serve.js",
    "test": "playwright test --project=baggage",
    "test:unit": "playwright test --project=unit",
    "test:smoke": "playwright test --project=baggage --grep @smoke",
    "test:all": "playwright test",
    "report": "tsx scripts/report.ts",
    "evidence": "tsx scripts/evidence.ts",
    "upload": "tsx scripts/upload.ts",
    "rejudge": "tsx scripts/rejudge.ts",
    "import-seed": "tsx scripts/import-seed.ts",
    "otp": "tsx scripts/otp.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1147.0",
    "@aws-sdk/credential-providers": "^3.1147.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^20.14.0",
    "@types/proper-lockfile": "^4.1.4",
    "proper-lockfile": "^4.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "yaml": "^2.6.0"
  }
}
