# Copy to .env (gitignored). Existing environment variables win over this file.

# Mailinator API token for the shared private inbox (pools with otp.provider: mailinator).
# If unset, the suite reads Secrets Manager `cct-qa/mailinator-token` (ca-central-1) with the aws CLI,
# using whatever AWS credentials / AWS_PROFILE are in the environment. Never printed.
MAILINATOR_API_TOKEN=
# MAILINATOR_DOMAIN=ae-qa1-aircanada.mailinator.com
# MAILINATOR_INBOX=lahiru

# Parallel chats (the OTP queue serialises the codes). Guide: 5 is safe.
# WORKERS=5

# OTP pacing (ms): gap between ANY two code requests, Mailinator poll, manual drop-box wait.
# OTP_GAP_MS=70000
# OTP_WAIT_MS=90000
# OTP_MANUAL_WAIT_MS=600000
# OTP_MAX_PER_DAY=5

# Local backend only (never QA): a fixed code for pools with otp.provider: fixed.
# ALLOW_FIXED_OTP=1
# OTP_FIXED_CODE=123456

# Chat page: default = hosted INT stable preview (https://cct-chat-stable.ac-cct-int.cloud.aircanada.com/).
# CHAT_URL=local uses the public-qa copy below; any other URL is used as given.
# CHAT_URL=local
# Password for the stable preview's sign-in screen.
CHAT_PASSWORD=

# Where the Ask AC host page lives (defaults to ../../public-qa-chat/public) and its port.
# CHAT_DIR=C:\Users\...\public-qa-chat\public
# CHAT_PORT=8765

# Report header: the deployed branch's short sha, if known.
# BUILD_SHA=
