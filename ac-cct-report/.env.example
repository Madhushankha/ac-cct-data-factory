# cct-report-viewer configuration. Copy to .env and fill in, then: docker-compose up -d
# (docker-compose reads this file). For ECS, set the same vars in the task definition.

# ── S3 report source ──────────────────────────────────────────────────────────
S3_BUCKET=cct-qa-artifacts-int
# layout: <RUNS_PREFIX>/<env>/<flow>/<run-id>/...
RUNS_PREFIX=runs
AWS_REGION=ca-central-1

# ── Session ───────────────────────────────────────────────────────────────────
# MUST be a fixed random string (stable across gunicorn workers). Use Secrets Manager in prod.
FLASK_SECRET=change-me-to-a-long-random-string

# ── Login ─────────────────────────────────────────────────────────────────────
# AUTH_MODE: 'basic' = username/password form login (DEV_AUTH); 'saml' = AC SSO via the broker.
AUTH_MODE=basic

# (A) basic — the form login credentials
DEV_AUTH=changeme:changeme

# (B) AC SSO via the shared SAML broker: set AUTH_MODE=saml and leave DEV_AUTH blank.
#AUTH_SERVICE_URL=https://ac-cct-int.cloud.aircanada.com
#APP_NAME=cct-report-viewer

# ── AWS credentials for S3 (local docker only) ────────────────────────────────
# On ECS the task ROLE provides these — do NOT set them there. Locally, either mount ~/.aws
# (see docker-compose) or paste temporary creds here:
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_SESSION_TOKEN=

# ── Jira / Xray (the two Jira dashboards) ─────────────────────────────────────
# Flow -> Jira component -> Xray Test Execution map lives in jira_flows.json (not here).
JIRA_BASE_URL=https://aircanada.atlassian.net
JIRA_PROJECT=CHAI
JIRA_EMAIL=
JIRA_API_TOKEN=
XRAY_BASE_URL=https://xray.cloud.getxray.app
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
# roll-ups are slow (~30-55s cold) so they're cached this many seconds
JIRA_CACHE_TTL=300
# the test-case -> Jira-issue mapping is persisted to s3://$S3_BUCKET/$MAPPING_PREFIX/<flow>.json
# (S3, not a local file: a file on the task disk is wiped by every redeploy, and confirming those
# mappings is manual work). The task role needs s3:PutObject on this prefix only.
MAPPING_PREFIX=mappings
# Jira "Testing Type" select, stamped on created bugs from the suite (SIT/UAT).
# Ids come from CHAI's create screen: "SIT Test"=14669, "UAT"=10370.
JIRA_TESTING_TYPE_FIELD=customfield_10153
TESTING_TYPE_SIT=14669
TESTING_TYPE_UAT=10370
